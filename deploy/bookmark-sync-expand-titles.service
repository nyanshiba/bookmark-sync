[Unit]
Description=bookmark-sync: expand short URLs in existing linkding titles
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 専用ユーザーで実行する（事前に作成: sudo useradd -m bookmark-sync）
User=bookmark-sync
Group=bookmark-sync
# 手動追加（ブックマークレット）分を含む既存タイトル内の短縮 URL を展開する。
# 対象が無ければ何もせず終了する（冪等）。-dry-run ではない本実行。
ExecStart=/home/bookmark-sync/bin/bookmark-sync-expand-titles -config /home/bookmark-sync/.config/bookmark-sync/config.toml
# 候補が多い場合の展開待ちを考慮して長めに
TimeoutStartSec=600
# 失敗しても systemd timer が次の機会に再実行する
Restart=no

[Install]
WantedBy=multi-user.target
