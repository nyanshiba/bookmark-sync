# ── 初期スーパーユーザー（初回起動時のみ有効） ──
# 初回起動時にだけ作成される。作成後は値を空にしてよい
# （空にすると以後 Web UI から作成できないため、パスワードは必ず記録しておくこと）
LD_SUPERUSER_NAME=bookmark-sync
LD_SUPERUSER_PASSWORD=CHANGE_ME_INITIAL_PASSWORD

# ── バックグラウンドタスク ──
# "True" にすると HTML スナップショット等のバックグラウンドタスクを無効化する。
# 大量のリンクで CPU を食う場合のみ True にする
LD_DISABLE_BACKGROUND_TASKS=False

# ── 自動バックアップ ──
# リンクディングが毎日自動でバックアップを作成するディレクトリ。
# データ用マウント /etc/linkding/data の配下なので、ホスト側から
# ./linkding-data/backups で取り出せる
LD_BACKUP_DIR=/etc/linkding/data/backups

# ── アクセス元オリジン（CSRF 許可） ──
# ドメイン名（linkding.home.arpa 等）でアクセスする場合、POST 要求の Origin が
# ホスト名と一致しないと CSRF エラーになる。実際のドメインに合わせて設定する。
# ポートを直接開く場合（http://linkding.home.arpa:9090）は
# プロトコル + ドメイン + ポートまでを書く。カンマ区切りで複数指定可。
LD_CSRF_TRUSTED_ORIGINS=http://linkding.home.arpa:9090

